{
  "name": "tft-matto-desktop",
  "version": "1.7.5",
  "private": true,
  "description": "마또 도우미 Windows 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64 --config.win.signAndEditExecutable=false",
    "dist:win-installer": "npm run prepack:web && electron-builder --win nsis --x64",
    "prepack:web": "node ../../scripts/bundle-web.cjs matto desktop web"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "gg.tft.matto.desktop",
    "productName": "마또 도우미",
    "asar": true,
    "files": [
      "main.js",
      "package.json",
      "icon.ico",
      "web/**/*",
      "web-updates.js",
      "preload.js",
      "mini-window.js"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
